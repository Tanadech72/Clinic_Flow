/**
 * สร้างแบบสอบถาม UAT ของ Clinic Flow ใน Google Forms อัตโนมัติ
 * เนื้อหาตรงกับ docs/uat-questionnaire.md
 *
 * วิธีใช้:
 * 1. เปิด https://script.google.com แล้วกด "โครงการใหม่" (New project)
 * 2. ลบโค้ดเดิมทั้งหมด แล้ววางโค้ดในไฟล์นี้
 * 3. เลือกฟังก์ชัน createUatForm แล้วกด "เรียกใช้" (Run)
 * 4. ครั้งแรกจะถามสิทธิ์ ให้กดอนุญาต (Review permissions → เลือกบัญชี → Advanced → Go to … → Allow)
 * 5. ดูลิงก์ฟอร์มที่ "บันทึกการดำเนินการ" (Execution log) ด้านล่าง
 */
function createUatForm() {
  const form = FormApp.create('แบบสอบถามความพึงพอใจระบบ Clinic Flow');
  form.setDescription(
    'แบบสอบถามนี้ใช้ประเมินความพึงพอใจหลังทดลองใช้ระบบ Clinic Flow (ระบบจัดการคลินิก) ' +
    'ซึ่งเป็นส่วนหนึ่งของโครงงานนิสิต กรุณาทำภารกิจทดลองใช้ให้ครบก่อนตอบแบบสอบถาม\n\n' +
    'ข้อมูลที่ใช้ทดลองเป็นข้อมูลสมมติทั้งหมด ห้ามกรอกข้อมูลของบุคคลจริง\n' +
    'คำตอบใช้เพื่อการศึกษาเท่านั้น และจะไม่เปิดเผยเป็นรายบุคคล'
  );
  form.setProgressBar(true);

  // ---------- ภารกิจทดลองใช้ ----------
  form.addSectionHeaderItem()
    .setTitle('ภารกิจทดลองใช้ (ทำก่อนตอบแบบสอบถาม)')
    .setHelpText(
      'ในบทบาทพยาบาล:\n' +
      '1) ลงทะเบียนผู้ป่วยใหม่ 1 ราย\n' +
      '2) บันทึกก่อนตรวจ: อาการ ความดัน ชีพจร อุณหภูมิ น้ำหนัก ส่วนสูง แล้วส่งเข้าคิว\n' +
      '3) (หลังแพทย์ตรวจเสร็จ) ตรวจสอบรายการยาและค่ายา แล้วยืนยันจ่ายยา\n' +
      '4) ยกเลิกคิวของผู้ป่วยอีก 1 ราย พร้อมระบุเหตุผล\n' +
      '5) รับยาเข้าสต๊อก 1 รายการ\n\n' +
      'ในบทบาทแพทย์:\n' +
      '1) เปิดคิวผู้ป่วยที่รอตรวจ ดูข้อมูลและสัญญาณชีพ\n' +
      '2) บันทึกการวินิจฉัย ค้นหายาและสั่งยา 2 รายการ\n' +
      '3) ลองสั่งยาที่ผู้ป่วยแพ้ แล้วสังเกตคำเตือน\n' +
      '4) ดูประวัติการรักษาของผู้ป่วย\n' +
      '5) ดูหน้าภาพรวมคลินิก'
    );

  // ---------- ส่วนที่ 1 ----------
  form.addPageBreakItem().setTitle('ส่วนที่ 1 ข้อมูลทั่วไป');
  form.addMultipleChoiceItem().setTitle('บทบาทที่ทดลองใช้')
    .setChoiceValues(['พยาบาล', 'แพทย์', 'ทั้งสองบทบาท']).setRequired(true);
  form.addMultipleChoiceItem().setTitle('สถานะ')
    .setChoiceValues(['บุคลากรทางการแพทย์', 'นิสิต/นักศึกษาสายสุขภาพ', 'นิสิต/นักศึกษาสายอื่น'])
    .showOtherOption(true).setRequired(true);
  form.addCheckboxItem().setTitle('อุปกรณ์ที่ใช้ทดสอบ (เลือกได้มากกว่า 1)')
    .setChoiceValues(['คอมพิวเตอร์', 'โทรศัพท์มือถือ', 'แท็บเล็ต']).setRequired(true);

  // ---------- ส่วนที่ 2 ----------
  form.addPageBreakItem().setTitle('ส่วนที่ 2 ความพึงพอใจต่อระบบ')
    .setHelpText('5 = มากที่สุด, 4 = มาก, 3 = ปานกลาง, 2 = น้อย, 1 = น้อยที่สุด');
  const columns = ['5 มากที่สุด', '4 มาก', '3 ปานกลาง', '2 น้อย', '1 น้อยที่สุด'];
  const groups = [
    ['ด้านการใช้งาน', [
      '1. ระบบใช้งานง่าย เข้าใจได้โดยไม่ต้องอธิบายมาก',
      '2. ลำดับขั้นตอนการทำงาน (บันทึกก่อนตรวจ → ตรวจ → จ่ายยา) สอดคล้องกับการทำงานจริงในคลินิก',
      '3. ค้นหาผู้ป่วยและค้นหายาได้สะดวกและรวดเร็ว',
      '4. ข้อความแจ้งเตือนและข้อความผิดพลาดเข้าใจง่าย บอกได้ว่าต้องแก้อย่างไร',
    ]],
    ['ด้านความถูกต้องและความปลอดภัย', [
      '5. ข้อมูลที่บันทึก (ผู้ป่วย สัญญาณชีพ การรักษา ยา) แสดงผลถูกต้องครบถ้วน',
      '6. ระบบเตือนแพ้ยาช่วยลดความเสี่ยงในการสั่งยา',
      '7. การตัดสต๊อกและค่ายาเมื่อจ่ายยาถูกต้องและเชื่อถือได้',
      '8. ผู้ใช้แต่ละบทบาทเห็นเฉพาะเมนูและข้อมูลที่จำเป็นต่อหน้าที่',
    ]],
    ['ด้านการออกแบบ', [
      '9. หน้าจอสวยงาม อ่านง่าย สบายตา',
      '10. ข้อมูลสำคัญ (เช่น ยาที่แพ้ ค่าสัญญาณชีพผิดปกติ) เห็นได้ชัดเจน',
    ]],
    ['ภาพรวม', [
      '12. ระบบช่วยให้การทำงานในคลินิกเป็นระบบและรวดเร็วขึ้น',
      '13. ความพึงพอใจโดยรวมต่อระบบ',
    ]],
  ];
  for (const [title, rows] of groups) {
    form.addGridItem().setTitle(title).setRows(rows).setColumns(columns).setRequired(true);
  }
  // ข้อ 11 แยกไว้ เพราะตอบเฉพาะผู้ที่ทดสอบบนมือถือ (ไม่บังคับ)
  form.addScaleItem()
    .setTitle('11. ใช้งานบนโทรศัพท์มือถือได้สะดวก')
    .setHelpText('ตอบเฉพาะผู้ที่ทดสอบบนโทรศัพท์มือถือ ถ้าไม่ได้ใช้มือถือให้ข้าม')
    .setBounds(1, 5).setLabels('น้อยที่สุด', 'มากที่สุด').setRequired(false);

  // ---------- ส่วนที่ 3 ----------
  form.addPageBreakItem().setTitle('ส่วนที่ 3 ข้อเสนอแนะ');
  form.addParagraphTextItem().setTitle('สิ่งที่ชอบที่สุดในระบบ');
  form.addParagraphTextItem().setTitle('ปัญหาหรือจุดที่ใช้งานยาก');
  form.addParagraphTextItem().setTitle('ฟังก์ชันที่อยากให้เพิ่ม');

  form.setConfirmationMessage('ขอบคุณที่สละเวลาทดลองใช้และตอบแบบสอบถามครับ/ค่ะ');

  // สร้าง Google Sheets ไว้รวมคำตอบ (ใช้คำนวณค่าเฉลี่ยในรายงาน)
  const sheet = SpreadsheetApp.create('ผลแบบสอบถาม Clinic Flow (UAT)');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  Logger.log('ลิงก์สำหรับส่งให้ผู้ทดลอง: ' + form.getPublishedUrl());
  Logger.log('ลิงก์แก้ไขฟอร์ม: ' + form.getEditUrl());
  Logger.log('ไฟล์รวมคำตอบ (Google Sheets): ' + sheet.getUrl());
}
